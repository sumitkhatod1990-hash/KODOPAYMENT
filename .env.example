# QivroPay Gateway Environment Config
PORT=4000
NODE_ENV=production

# Merchant of Record Credentials
QIVROPAY_BRAND_NAME="QivroPay"
QIVROPAY_STATEMENT_DESCRIPTOR="QIVROPAY"
QIVROPAY_TAX_NEXUS_ID="replace_with_tax_registration_id"

# Security & Secrets
QIVROPAY_LIVE_SECRET_KEY=replace_with_secret_in_hosting_provider
QIVROPAY_WEBHOOK_SECRET=replace_with_webhook_secret_in_hosting_provider

# Bank Rails & Settlement
SETTLEMENT_SCHEDULE="T+2_DAILY"
