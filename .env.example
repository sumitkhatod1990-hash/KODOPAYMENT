# ==========================================
# QivroPay — LOCAL DEVELOPMENT environment config
# ==========================================
# Copy this file to .env and adjust as needed:
#   cp .env.example .env
#
# This file configures the backend (server/index.js) for a fully local,
# self-contained development setup. It does NOT require access to any
# production database or the client's old backend.

# Server settings
NODE_ENV=development
PORT=4000

# Frontend origin allowed to call the API with credentials (cookies).
# The Vite dev server runs on this by default (see vite.config.ts).
CORS_ORIGIN=http://localhost:3000

# Application identity (safe to leave as-is for local development)
QIVROPAY_BRAND_NAME="QivroPay"
QIVROPAY_STATEMENT_DESCRIPTOR="QIVROPAY"

# Session signing secret, used to sign hosted-checkout session tokens.
# Any random string works locally. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QIVROPAY_SESSION_SECRET=local_dev_session_secret_change_me

# --------------------------------------------------------------
# Persistence
# --------------------------------------------------------------
# Leave DATABASE_URL / POSTGRES_URL unset for local development.
# When unset, the backend automatically uses a local, file-based
# development store (server/.data/dev-store.json, gitignored) instead of
# Neon Postgres. This store is created automatically and is completely
# isolated from any production database — it is only ever used when
# NODE_ENV is not "production" and no DATABASE_URL is configured.
#
# To develop against a real Postgres/Neon database instead, set:
# DATABASE_URL=postgres://user:password@host/dbname
DATABASE_URL=

# --------------------------------------------------------------
# Google Sign-In ("Continue with Google")
# --------------------------------------------------------------
# Create an OAuth 2.0 Client ID of type "Web application" in Google Cloud
# Console (APIs & Services > Credentials), and add this app's origin(s)
# (e.g. http://localhost:3000) under "Authorized JavaScript origins".
# Only the Client ID is needed — the Google Identity Services ID-token flow
# used here never requires a client secret, and one must never be added to
# this file or shipped to the frontend.
#
# GOOGLE_CLIENT_ID (backend) and VITE_GOOGLE_CLIENT_ID (frontend, exposed to
# the browser by Vite) must be set to the SAME Client ID: the frontend uses
# it to render Google's button, the backend uses it to verify that a
# submitted Google ID token was actually issued for this app before trusting
# it. Leave both blank to develop without Google Sign-In — the button simply
# does not render and existing email/password auth is unaffected.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# --------------------------------------------------------------
# Cashfree payment gateway (optional for local auth/dashboard development)
# --------------------------------------------------------------
# Leave these blank to develop and test the auth/dashboard flows without
# Cashfree. Payment-session creation will return a clear error until sandbox
# credentials are configured here. Never put live/production keys in this
# file — configure those only in your hosting provider's environment.
#
# CASHFREE_ENV is the ONLY place the Cashfree environment is configured.
# Accepted values: "sandbox" or "production" (alias "prod" also accepted).
# There is no separate frontend env var for this — the checkout page reads
# the resolved environment from the backend (GET /api/v1/payments/session/:id)
# so the browser's Cashfree SDK and the backend's Cashfree REST calls can
# never disagree about which environment a payment runs against.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=

# --------------------------------------------------------------
# Cashfree PARTNER / EMBEDDED PAYMENTS (Phase 10.8A — sandbox foundation)
# --------------------------------------------------------------
# A completely separate Cashfree product/credential from CASHFREE_APP_ID/
# CASHFREE_SECRET_KEY above. Those authenticate QivroPay's own Cashfree
# merchant account (x-client-id/x-client-secret) to create/refund THIS
# platform's own orders. CASHFREE_PARTNER_API_KEY instead authenticates
# QivroPay as a Cashfree PARTNER (x-partner-apikey) to onboard and manage
# OTHER merchants' Cashfree sub-accounts. Never put the same value in both —
# the Partner API key is not accepted by the PG endpoints and vice versa.
#
# Get a TEST/SANDBOX Partner API key from the Partner Dashboard
# (Developers > API Keys, with "Switch to Test" selected):
# https://partner.cashfree.com/partner-ui/dashboard/developers/api-keys?env=test
# Never put a LIVE Partner API key here or in any file committed to git.
CASHFREE_PARTNER_API_KEY=

# Independent of CASHFREE_ENV above. Accepted values: "sandbox" (default if
# unset) or "production" ("prod" also accepted). Deliberately does NOT
# auto-promote to production based on NODE_ENV — this stays "sandbox" until
# someone explicitly opts in, since Partner KYC/production readiness is a
# separate, later decision from the rest of this app's environment.
CASHFREE_PARTNER_ENV=sandbox

# Optional. Defaults to "2023-01-01" (server/cashfreePartner.js), matching
# the Cashfree Partner merchant-onboarding API reference's documented
# default. Only set this if a specific Partner endpoint you're using
# documents a different required version.
# CASHFREE_PARTNER_API_VERSION=2023-01-01

# --------------------------------------------------------------
# Groq AI Support Assistant (Server-Only Secret)
# --------------------------------------------------------------
# Get your API key from https://console.groq.com/keys
# NEVER expose this key to the frontend or create VITE_GROQ_API_KEY.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --------------------------------------------------------------
# Brevo Transactional Email (Server-Only Secret)
# --------------------------------------------------------------
# Get your API key from Brevo Dashboard (SMTP & API -> API Keys)
# NEVER expose this key to the frontend or create VITE_BREVO_API_KEY.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=info@qivropay.com
BREVO_SENDER_NAME=QivroPay