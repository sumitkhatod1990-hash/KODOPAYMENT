# ==========================================
# QIVROPAY PAYMENTS (INDIA MERCHANT OF RECORD)
# PRODUCTION ENVIRONMENT CONFIGURATION
# ==========================================

# Server Settings
NODE_ENV=production
PORT=4000
PUBLIC_URL=https://yourdomain.com

# Cashfree Payment Gateway Credentials (set only in the hosting provider)
# Replace with your LIVE production credentials from merchant.cashfree.com
CASHFREE_APP_ID=replace_with_cashfree_live_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key_here
CASHFREE_ENV=PROD
CASHFREE_API_VERSION=2023-08-01

# Webhook Security
QIVROPAY_WEBHOOK_SECRET=replace_with_webhook_secret

# Merchant Default Settlement Details
BENEFICIARY_IFSC=replace_with_verified_ifsc
BENEFICIARY_ACCOUNT=replace_with_verified_account
BENEFICIARY_NAME=replace_with_legal_entity_name
