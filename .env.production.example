# ==========================================
# QIVROPAY PAYMENTS 
# PRODUCTION ENVIRONMENT CONFIGURATION
# ==========================================

# Server Settings
NODE_ENV=production
PORT=4000
PUBLIC_URL=https://qivropay.com
# Optional: override the allowed CORS origin if the frontend is hosted
# separately from PUBLIC_URL. Defaults to PUBLIC_URL when unset.
CORS_ORIGIN=https://qivropay.com

# Cashfree Payment Gateway Credentials (set only in the hosting provider)
# Replace with your LIVE production credentials from merchant.cashfree.com
CASHFREE_APP_ID=replace_with_cashfree_live_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key_here
# CASHFREE_ENV is the ONLY place the Cashfree environment is configured —
# accepted values are "sandbox" or "production" ("prod" also accepted as an
# alias). There is no separate frontend env var: the checkout page reads the
# resolved environment from the backend, so the browser's Cashfree SDK and
# the backend's Cashfree REST calls can never disagree.
CASHFREE_ENV=production
CASHFREE_API_VERSION=2025-01-01
DATABASE_URL=replace_with_neon_connection_string

# Webhook & session security
# The webhook secret from your Cashfree dashboard's webhook configuration.
# server/index.js accepts either variable name below (CASHFREE_WEBHOOK_SECRET
# takes priority if both are set) — set exactly one of them, not both, to
# avoid ambiguity about which value is actually in effect.
CASHFREE_WEBHOOK_SECRET=replace_with_webhook_secret
# QIVROPAY_WEBHOOK_SECRET=replace_with_webhook_secret
QIVROPAY_SESSION_SECRET=replace_with_long_random_session_secret

# --------------------------------------------------------------
# Google Sign-In ("Continue with Google")
# --------------------------------------------------------------
# Web application OAuth Client ID from Google Cloud Console, with this
# domain's production origin added under "Authorized JavaScript origins".
# Both variables must hold the SAME Client ID (frontend renders the button
# with VITE_GOOGLE_CLIENT_ID, backend verifies tokens against
# GOOGLE_CLIENT_ID). No client secret is used or required — never set one
# here or anywhere reachable by the frontend build.
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id
VITE_GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id

# --------------------------------------------------------------
# Cashfree PARTNER / EMBEDDED PAYMENTS (Phase 10.8A — SANDBOX ONLY so far)
# --------------------------------------------------------------
# NOT yet part of any live QivroPay flow — see server/cashfreePartner.js.
# Separate credential from CASHFREE_APP_ID/CASHFREE_SECRET_KEY above; do not
# reuse either value here. Leave CASHFREE_PARTNER_ENV at "sandbox" (or unset)
# until Partner KYC is approved and a production Partner integration has
# actually been reviewed and implemented — this file documents the variable
# names for when that day comes, not an instruction to flip it now.
# CASHFREE_PARTNER_API_KEY=replace_with_cashfree_partner_api_key
# CASHFREE_PARTNER_ENV=sandbox

# NOTE: BENEFICIARY_IFSC / BENEFICIARY_ACCOUNT / BENEFICIARY_NAME were listed
# here in earlier drafts of this file but are not read by any code path in
# this repository (V1 has no bank payouts — Cashfree settles directly to the
# merchant's own Cashfree-registered bank account). Do not rely on setting
# them to configure settlement; they currently do nothing.

# --------------------------------------------------------------
# Groq AI Support Assistant (Server-Only Secret)
# --------------------------------------------------------------
# GROQ_API_KEY=replace_with_production_groq_api_key
# GROQ_MODEL=openai/gpt-oss-20b

# --------------------------------------------------------------
# Brevo Transactional Email (Server-Only Secret)
# --------------------------------------------------------------
# BREVO_API_KEY=replace_with_production_brevo_api_key
# BREVO_SENDER_EMAIL=info@qivropay.com
# BREVO_SENDER_NAME=QivroPay




